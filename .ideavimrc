" :actionlist to see full list of intellij idea actions
set exrc
" NOTE: `set guicursor=` (empty) breaks IdeaVim 2.39.0 command-line entry on
" IDEA 2026.1 -> VIM-4115 'Cannot perform operation. Too complex, sorry' on `:`.
" Leave disabled, or use an explicit value instead of empty.
" set guicursor=
set nowrap
set sidescroll=1
set hidden
set nobackup
set noswapfile
set nowritebackup
set updatetime=300
set timeoutlen=500
set shortmess+=c
set tabstop=2
set smarttab
set shiftwidth=2
set expandtab
set number
set numberwidth=2
set encoding=UTF-8
set nocompatible
set cmdheight=2
set background=dark
set undodir=~/.nvim/undodir
set undofile
set cursorline
set scrolloff=4
set sidescrolloff=8
set signcolumn=yes
set autoread
set exrc
set secure
set visualbell
set noerrorbells

" remap leader to space
let mapleader = " "
nnoremap <SPACE> <NOP>
" no more arrow keys
inoremap  <Up>     <NOP>
inoremap  <Down>   <NOP>
inoremap  <Left>   <NOP>
inoremap  <Right>  <NOP>
noremap   <Up>     <NOP>
noremap   <Down>   <NOP>
noremap   <Left>   <NOP>
noremap   <Right>  <NOP>
" line moving
nnoremap  <A-k> :m .-2<CR>==
nnoremap  <A-j> :m .+1<CR>==
vnoremap  <A-j> :m '>+1<CR>gv=gv
vnoremap  <A-k> :m '<-2<CR>gv=gv
" disable suspend
nnoremap  <C-z> <NOP>
" disable ctrl u in insert mode
inoremap  <C-u> <NOP>
" jj to exit insert mode
inoremap  jj <Esc>
" no more esc
inoremap  <Esc> <NOP>
" no more ctrl-c
inoremap  <C-c> <NOP>
" easy save
nnoremap  <Leader>w :action SaveDocument<CR>
" indentation
nnoremap  <Tab> >>
nnoremap  <BS> <<
vnoremap  <Tab> >gv
vnoremap  <BS> <gv
" use system clipboard
noremap <Leader>y "+y
noremap <Leader>p "+p
" paste last yanked thing
noremap P "0p
" replace all pattern
nnoremap <Leader>r :%s/from/to/g
" replace exact all pattern
nnoremap <Leader>re :%s/\<from\>/to/gc
" switch alternate file
nnoremap <Leader>af :b#<CR>
" switch prev buffer
nnoremap <Leader>bb :bp<CR>
" switch next buffer
nnoremap <Leader>bn :bn<CR>
" left right for command mode
nnoremap <Leader>bf :Buffers<CR>
" left right for command mode
cnoremap <C-h> <Left>
cnoremap <C-l> <Right>
" disable lowercase in visual mode
vnoremap u <NOP>
" go to definition
noremap <Leader>cd gd
" go to implementation command f12
noremap gi :action GotoImplementation<CR>
" show usages (opens popup)
noremap gr :action ShowUsages<CR>
" find usages
noremap gR :action FindUsages<CR>
" rename
noremap R :action RenameElement<CR>
" trigger code completion
noremap <Leader><Leader> :action CodeCompletion<CR>
" insert @feedback comment above visual selection
function! AddFeedbackComment()
  let l:s = line("'<")
  let l:e = line("'>")
  let @z = "// @feedback [Line " . (l:s + 1) . " to " . (l:e + 1) . "]:"
  execute (l:s - 1) . "put z"
endfunction
vnoremap <Leader>f :<C-u>call AddFeedbackComment()<CR>
